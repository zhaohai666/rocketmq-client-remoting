{
  "name": "rocketmq-client-remoting-nodejs",
  "version": "5.5.1",
  "description": "Apache RocketMQ classic remoting protocol client for Node.js.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "README.en.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json --noCheck && node fix-dts-imports.mjs",
    "prepare": "npm run build",
    "pack": "npm run build && npm pack",
    "test": "node --experimental-strip-types --test",
    "typecheck": "tsc --noEmit",
    "selfcheck": "node --experimental-strip-types selfcheck.ts",
    "smoke:dist": "node smoke_dist.mjs",
    "live:producer": "node --experimental-strip-types examples/live_producer.ts",
    "live:consumer": "node --experimental-strip-types examples/live_consumer.ts",
    "live:pull": "node --experimental-strip-types examples/live_pull.ts",
    "live:lite_pull": "node --experimental-strip-types examples/live_lite_pull.ts",
    "live:admin": "node --experimental-strip-types examples/live_admin.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
