<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>RocketMQ</RootNamespace>
    <AssemblyName>RocketMQ.Client</AssemblyName>
    <!-- 只依赖 BCL：JSON 容错解析、zlib 压缩、TCP 传输全部自实现或走框架内置，不引入额外包依赖。 -->
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>RocketMQ.Client.Remoting</PackageId>
    <Description>Apache RocketMQ 经典 remoting 协议客户端</Description>
  </PropertyGroup>

</Project>
