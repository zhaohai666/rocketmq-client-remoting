<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>RocketMQ</RootNamespace>
    <AssemblyName>RocketMQ.Client</AssemblyName>
    <!-- BCL-only: JSON fault-tolerant parsing, zlib compression and TCP transport are all
         self-implemented or use framework built-ins; no extra package dependencies. -->
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>RocketMQ.Client.Remoting</PackageId>
    <Description>Apache RocketMQ client for the classic remoting protocol</Description>
  </PropertyGroup>

</Project>
