<Project>

  <!-- Shared properties for all projects under csharp/.
       The goal is "zero warnings", so compiler warnings are treated as errors. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <!-- Deterministic output, so "the same source always produces the same binary" can be verified -->
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- ⚠ Do NOT enable InvariantGlobalization: the client needs real time-zone/region capabilities
       (log timestamps, time formatting). Numeric/date formatting at the protocol layer **must pass
       CultureInfo.InvariantCulture explicitly** — otherwise under de-DE and similar locales
       double.ToString() emits "1,5" instead of "1.5" and the JSON is silently corrupted. This is
       enforced point by point in Json/Serialize. -->

</Project>
