<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>RocketMQ.Examples</RootNamespace>
    <AssemblyName>rmq</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Live-cluster verification tool collection.
         One executable + subcommands, avoiding the duplicated overhead of multiple csproj files.
         Subcommands: selfcheck / interop / message-types / admin-live / compression-live /
         redelivery / acl / pull / rr / latency / pop / popc / pop-batch-ack / trace.
         See csharp/README.md for usage. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/RocketMQ.Client/RocketMQ.Client.csproj" />
  </ItemGroup>

</Project>
