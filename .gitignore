# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# C# / .NET
csharp/**/bin/
csharp/**/obj/
dotnet/**/bin/
dotnet/**/obj/
*.user

# Test / tool caches
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# Rust
rust/target/
**/*.rs.bk

# IDE
.idea/
.vscode/
*.iml

# OS
.DS_Store
Thumbs.db

# Accidentally left redirection files (nohup etc.)
nohup.out

# Client logs: the python/php clients write to logs/rocketmqlogs under the **current working
# directory** by default (deliberately not $HOME; see python/rocketmq_logging.py,
# php/src/Client/Logger.php). Running examples/tests from the repo root or a port directory
# grows this directory.
logs/

# Local agent working directory (project memory / temp scripts), not committed
.workbuddy/

# Stray cmake artifacts (produced by accidentally running cmake in the repo root or a non-build
# directory; the proper build dirs of cpp/go etc. maintain their own and are not listed here)
CMakeCache.txt
CMakeFiles/
CTestTestfile.cmake
cmake_install.cmake
Makefile
cpp/build_scrub_b/
nodeJs/selfcheck.ts.log
